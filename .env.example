# =============================================================================
# mcfr 配置文件示例
#
# 用法：把本文件复制为 .env，按需修改后重新启动 python run.py
#       .env 已在 .gitignore 中，不会被提交
#
# ！v0.21 起【不再需要任何邮件配置】。
#   注册与登录卡的是本站自己画的图片验证码（backend/captcha.py），
#   不联网、不花钱、不需要填主机 / 端口 / 授权码。
#   如果你是从旧版本升级上来的，.env 里残留的 MCFR_MAIL_* 与 MCFR_SMTP_*
#   已经不会被读取，可以放心删掉。
# =============================================================================

# -----------------------------------------------------------------------------
# 其他
# -----------------------------------------------------------------------------
# 验证码签名密钥。留空即可：首次启动会自动生成 data/server_secret.key 并一直复用，
# 重启服务不会让用户手里那张验证码失效。只有想用固定的自定义密钥时才需填写。
MCFR_CODE_SECRET=

# ！早期版本的 MCFR_SEED 已经作废：内置的 12 个演示账号在 v0.13 就整体删掉了，
#   而那个开关一直没从模板里拿掉，写成 1 也不会有任何效果。
#   老 .env 里残留的那一行不会被读取，可以放心删掉 —— 现在全新安装一律是空库。

# -----------------------------------------------------------------------------
# 安全相关（一般保持默认即可）
# -----------------------------------------------------------------------------

# 反向代理的地址。**默认留空**，也就是「只信任 TCP 直连来源」。
#
# ！不要随手写成 * 或 0.0.0.0/0：X-Forwarded-For 是客户端可以随便伪造的头，
#   一旦无条件信任它，所有按 IP 的限流都会失效 —— 尤其是后台登录的失败次数
#   限制，那等于把管理员口令敞开给暴力破解。
#   只有确实跑在 Nginx / Caddy 后面时，才填代理自己的地址：
#       MCFR_TRUSTED_PROXIES=127.0.0.1
#   多个用逗号分隔，也可以写网段（如 10.0.0.0/8）。
MCFR_TRUSTED_PROXIES=

# 允许跨域调用接口的来源。前后端由同一个进程提供，正常部署下留空即可。
# 留空 = 不开启 CORS，别的网站无法用 JS 调这套接口。
MCFR_ALLOWED_ORIGINS=

# 是否公开 /api/docs 接口文档。默认关闭 —— 它相当于一份现成的接口清单。
# 自己调试时改成 1 可以打开。
MCFR_ENABLE_DOCS=0

# -----------------------------------------------------------------------------
# 管理后台（访问 http://你的域名/admin ）
# -----------------------------------------------------------------------------
# 这个口令是后台唯一的入口。
#
# ！留空即可。首次启动时程序会【随机生成】一个并写回本文件，
#   同时把口令打印在启动日志里（journalctl -u mcfr -n 50）。
#
# ！不要在这里写 change-me 之类的占位词 —— 程序会把它们当成“没填”，
#   然后自动生成新的，你反而登不进去。
#
# 想自己指定：在这里写上一串只有自己知道的复杂口令，重启服务即可生效。
MCFR_ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# 桌面启动器的微软正版登录（v0.33 起）
# -----------------------------------------------------------------------------
#
# ！这两个值只在**服务器**上。启动器里一个字节都没有 ——
#   它启动登录时只问本站要一个设备码，剩下的全由服务器去跟微软谈。
#   所以别人反编译启动器也拿不到你的应用凭据。
#
# MCFR_MS_CLIENT_ID 是 Azure 门户里那个「应用程序(客户端) ID」，形如
#   12345678-1234-1234-1234-123456789abc
# 留空 = 启动器上的「微软正版登录」按钮会显示为暂不可用（离线账号照常能用）。
MCFR_MS_CLIENT_ID=

# 受支持的帐户类型：
#   consumers = 仅个人 Microsoft 帐户（本项目注册的就是这种，推荐）
#   common    = 任何组织目录中的帐户和个人 Microsoft 帐户
#   或者填具体的租户 ID。一般留空即可，服务器会依次尝试 consumers → common → 本项。
MCFR_MS_TENANT=
